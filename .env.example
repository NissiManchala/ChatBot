# Choose one: groq (free LLM + free local embeddings) or openai
PROVIDER=groq

# --- Groq (PROVIDER=groq) ---
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# --- OpenAI (PROVIDER=openai) ---
OPENAI_API_KEY=your_openai_api_key
LLM_MODEL=gpt-4o-mini

# --- Pinecone (always required) ---
PINECONE_API_KEY=your_pinecone_api_key
# Use a NEW name when you change provider: the index dimension must match the embedding model
# (groq/fastembed = 384, openai = 1536).
PINECONE_INDEX_NAME=agentic-ai-index-384
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Optional: minimum similarity of the best chunk before the LLM is even called
# (defaults: 0.50 for groq/fastembed, 0.30 for openai)
# MIN_SCORE=0.50